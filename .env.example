# ============================================================================
# Cherish Moments Decor — automation environment variables
# ----------------------------------------------------------------------------
# Copy this file to ".env" for local development (vercel dev), and add the SAME
# keys in Vercel → Project → Settings → Environment Variables for production.
#
# NEVER commit real values. NEVER expose these to the browser — they are only
# read server-side inside /api functions.
# ============================================================================

# ---- Email: Resend (https://resend.com) ----
# Create an API key, and verify your sending domain for best deliverability.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The "from" must use a domain you've verified in Resend.
EMAIL_FROM=Cherish Moments Decor <hello@cherishmomentsdecor.com>

# ---- Staff notifications ----
STAFF_EMAIL=cherishmomentsdecorllc@gmail.com
# Optional: staff mobile number (E.164) for internal SMS alerts. Leave blank to disable.
STAFF_SMS=

# ---- SMS: Twilio (https://twilio.com) ----
# Leave these blank until you're ready — SMS is skipped gracefully if unset.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio phone number in E.164 format, e.g. +13475551234
TWILIO_FROM_NUMBER=

# ---- Storage: Supabase (https://supabase.com) ----
# Project URL and the SERVICE ROLE key (Settings → API). Server-only.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
SUPABASE_TABLE=consultations

# ---- Business / branding (safe, non-secret) ----
BUSINESS_NAME=Cherish Moments Decor
BUSINESS_PHONE=(352) 349-9494
SITE_URL=https://www.cherishmomentsdecor.com
INSTAGRAM_URL=https://www.instagram.com/cherish_moments_decor/
LOGO_URL=https://www.cherishmomentsdecor.com/assets/img/logo/cm-decor-emblem.png

# ---- Delivery tuning (optional) ----
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=400

# ---- Optional anti-spam shared secret ----
# If set, the frontend must send the same value in the "x-form-token" header.
# (Not required — the honeypot field already blocks most bots.)
FORM_TOKEN=
